{
  "name": "@icure/api",
  "version": "8.10.1",
  "description": "Typescript version of iCure standalone API client",
  "types": "dist/index.d.ts",
  "dependencies": {
    "date-fns": "^2.23.0",
    "libphonenumber-js": "^1.7.18"
  },
  "devDependencies": {
    "@icure/apiV6": "npm:@icure/api@6.4.4",
    "@icure/apiV7": "npm:@icure/api@7.1.32",
    "@icure/test-setup": "0.0.71",
    "@playwright/test": "^1.59.1",
    "@types/chai": "^4.3.0",
    "@types/chai-as-promised": "^7.1.1",
    "@types/isomorphic-fetch": "^0.0.36",
    "@types/md5": "^2.3.2",
    "@types/mocha": "^9.1.0",
    "@types/node": "^18.19.75",
    "@types/node-localstorage": "^1.3.0",
    "@types/react": "^19.2.7",
    "@types/react-dom": "^19.2.3",
    "@types/rsocket-core": "^0.0.7",
    "@types/rsocket-websocket-client": "^0.0.4",
    "@types/uuid": "^8.3.4",
    "@types/ws": "^8.5.3",
    "axios": "^0.26.1",
    "chai": "^4.3.6",
    "chai-as-promised": "^7.1.1",
    "isomorphic-fetch": "^3.0.0",
    "lzma": "^2.3.2",
    "md5": "^2.3.0",
    "mocha": "^9.2.2",
    "node-localstorage": "^2.2.1",
    "nyc": "^15.1.0",
    "otpauth": "^9.1.5",
    "prettier": "^2.6.2",
    "pretty-quick": "^3.1.3",
    "rimraf": "^3.0.2",
    "source-map-support": "^0.5.21",
    "text-encoding": "^0.7.0",
    "ts-loader": "^9.5.2",
    "ts-node": "^10.7.0",
    "typescript": "^5.8.2",
    "uuid": "^8.3.2",
    "uuid-encoder": "^1.1.0",
    "webpack": "^5.98.0",
    "webpack-cli": "^6.0.1",
    "ws": "^8.18.0"
  },
  "scripts": {
    "eslint": "eslint --fix icc-api/* icc-x-api/*",
    "build": "tsc && mkdir -p dist/icc-x-api/wasm/lzma && cp icc-x-api/wasm/lzma/lzma.js icc-x-api/wasm/lzma/lzma.wasm dist/icc-x-api/wasm/lzma",
    "testwp": "echo 'Test webpack build' && yarn webpack --config buildconfig/webpack.config.js || rm -rf dist && rm -rf buildconfig/dist-wp",
    "prepare": "rimraf dist && npm run build && jq '{name:.name, version:.version, description:.description, main:\"index.js\", types:\"index.d.ts\", dependencies:.dependencies, author:.author, license:.license, bugs:.bugs, homepage:.homepage}' < package.json > dist/package.json && yarn testwp",
    "publish": "yarn run prepare && cd dist && cp ../.npmignore . && npm publish && cd ..",
    "precommit": "pretty-quick --staged",
    "test": "nyc mocha \"test/icc-api/*.ts\" --require ts-node/register --require source-map-support/register --timeout=60000 --recursive",
    "lzma": "playwright test --config test/benchmarks/playwright.config.ts",
    "clean": "npx ts-node test-scripts/cleanup.ts"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/taktik/icc-api.git"
  },
  "prettier": {
    "semi": false,
    "printWidth": 150,
    "singleQuote": true
  },
  "nyc": {
    "extension": [
      ".ts",
      ".tsx"
    ],
    "exclude": [
      "**/*.d.ts"
    ],
    "reporter": [
      "html",
      "lcov"
    ],
    "all": true
  },
  "author": "Taktik sa - B12 Consulting",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/icure/icc-api/issues"
  },
  "homepage": "https://github.com/icure/icc-api#readme",
  "packageManager": "yarn@3.8.7"
}
